# 로컬 실행용 설정 예시. 이 파일을 .env 로 복사해 값을 채우세요 (.env 는 git 에 올라가지 않습니다)
# GitHub Actions 에서는 같은 이름으로 Secrets / Variables 에 등록합니다 (python scripts/push_secrets.py).

# ── 블로그 (Variables) ──────────────────────────────
BLOG_NAME=AI백과사전
# 구글 토큰 발급 때 로그인 화면에 미리 선택할 계정 (scripts/get_google_token.py)
GOOGLE_ACCOUNT_EMAIL=rkdghkclgns@gmail.com

# ── 구글 (Secrets) : scripts/get_google_token.py 로 발급 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# ── Gemini (Secrets) : https://aistudio.google.com/apikey (구글 검색 근거 기능 사용, 무료 한도) ──
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash

# ── 블로그 이미지 저장소 (구글 드라이브 대신 Cloudflare Worker + KV) ──
# python scripts/image_host_secret.py 가 만들어 .env·Worker·GitHub 에 한 번에 등록
IMAGE_HOST_URL=
IMAGE_UPLOAD_TOKEN=

# ── 슬랙 YooPost (Secrets) : 봇 토큰+채널 ID 권장 (파일 업로드 가능). 웹훅만 쓰면 텍스트 알림만 가능 ──
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=
# (Variables) 원고 승인 채널(#yoopost-1-원고승인)·발행 완료 채널(#yoopost-2-발행완료) ID — scripts/setup_slack_channels.py 가 채움
# 봇(@yoopost)을 각 채널에 초대해야 파일 업로드가 됩니다.
SLACK_CHANNEL_DRAFT=
SLACK_CHANNEL_PUBLISH=

# ── 동작 옵션 (Variables) ──────────────────────────────
# 주제 후보로 볼 최근 기간(일)
TOPIC_LOOKBACK_DAYS=3
# 글마다 최소 확인된 출처 수 (공식 발표·1차 자료 우선)
MIN_REFERENCES=3
# 사실 검증에서 틀린 주장이 나오면 원고를 고쳐 다시 검증하는 최대 횟수 (통과 못하면 발행 보류)
MAX_FIX_ROUNDS=2
# 본문 최소 분량 (공백 제외)
MIN_BODY_CHARS=5000
OUTPUT_DIR=output
# FONT_PATH=C:/Windows/Fonts/malgunbd.ttf
