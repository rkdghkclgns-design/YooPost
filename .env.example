# 로컬 실행용 설정 예시. 이 파일을 .env 로 복사해 값을 채우세요 (.env 는 git 에 올라가지 않습니다)
# GitHub Actions 에서는 같은 이름으로 Secrets / Variables 에 등록합니다 (python scripts/push_secrets.py).

# ── 블로그 (Variables) ──────────────────────────────
BLOG_NAME=AI백과사전
DRIVE_ROOT_FOLDER_NAME=AI백과사전_포스팅자동화
# 구글 토큰 발급 때 로그인 화면에 미리 선택할 계정 (scripts/get_google_token.py)
GOOGLE_ACCOUNT_EMAIL=rkdghkclgns@gmail.com

# ── 구글 (Secrets) : scripts/get_google_token.py 로 발급 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# ── Gemini (Secrets) : https://aistudio.google.com/apikey (구글 검색 근거 기능 사용) ──
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash

# ── 슬랙 YooPost (Secrets) : 봇 토큰+채널 ID 권장 (파일 업로드 가능). 웹훅만 쓰면 텍스트 알림만 가능 ──
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=
# (Variables, 선택) 진행 단계별 결과물 채널 ID — 비우면 알림 채널의 진행 메시지 스레드에 올라감
# 봇(@yoopost)을 각 채널에 초대해야 파일 업로드가 됩니다.
SLACK_CHANNEL_RESEARCH=
SLACK_CHANNEL_DRAFT=
SLACK_CHANNEL_PUBLISH=
SLACK_CHANNEL_TOKEN_ALERT=

# ── 네이버 블로그 (Secrets) : scripts/export_naver_cookies.py 로 세션 저장 ──
NAVER_BLOG_ID=
NAVER_STORAGE_STATE_B64=
# publish(바로 발행) | draft(임시저장만 — 사람이 확인 후 발행)
NAVER_PUBLISH_MODE=publish
# left(기술 글 기본) | center
NAVER_ALIGN=left

# ── 선택: 갱신된 네이버 로그인 정보를 GitHub 시크릿에 자동 저장 (fine-grained PAT, Secrets: Read and write) ──
GH_SECRETS_TOKEN=

# ── 동작 옵션 (Variables) ──────────────────────────────
# 주제 후보로 볼 최근 기간(일)
TOPIC_LOOKBACK_DAYS=3
# 글마다 최소 확인된 출처 수 (공식 발표·1차 자료 우선)
MIN_REFERENCES=3
# 사실 검증에서 틀린 주장이 나오면 원고를 고쳐 다시 검증하는 최대 횟수 (통과 못하면 발행 보류)
MAX_FIX_ROUNDS=2
# 본문 최소 분량 (공백 제외)
MIN_BODY_CHARS=5000
OUTPUT_DIR=output
# FONT_PATH=C:/Windows/Fonts/malgunbd.ttf
